<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.alkadev</groupId>
    <artifactId>alka-parent</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>Alka</name>
    <description>The API of the Alka service engine (annotations, object plugin, object manager, common) and samples of a plugin and a manager.</description>
    <url>https://github.com/LejlaO/alka</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <java-compiler-version>25</java-compiler-version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- the version of Alka that a plugin or manager builds on. It is a property of its own and not project.version, because this pom is the parent of
             other projects (plugin-parent, and through it every plugin) and there project.version is the version of the plugin. Keep it equal to the version of this pom. -->
        <alka.version>0.1.0</alka.version>
    </properties>

    <modules>
        <module>annotations</module>
        <module>utils</module>
        <module>maven-plugin</module>
        <module>plugin-parent</module>
        <module>samples</module>
        <module>archetype</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- external -->
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-api</artifactId>
                <version>2.26.1</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
                <version>2.26.1</version>
            </dependency>

            <!-- the modules of this repository, all versioned in lockstep -->
            <dependency>
                <groupId>com.alkadev</groupId>
                <artifactId>annotations</artifactId>
                <version>${alka.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alkadev.utils</groupId>
                <artifactId>common</artifactId>
                <version>${alka.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alkadev.utils</groupId>
                <artifactId>objectmanager</artifactId>
                <version>${alka.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alkadev.utils</groupId>
                <artifactId>objectplugin</artifactId>
                <version>${alka.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.16.0</version>
                <configuration>
                    <release>${java-compiler-version}</release>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
